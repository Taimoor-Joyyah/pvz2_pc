set(angle_directory "@ACP_ANGLE_DIRECTORY@")
file(READ "@PROJECT_SOURCE_DIR@/cmake/angle-windows.lock.json" tested_angle)
foreach(name IN ITEMS libEGL.dll libGLESv2.dll d3dcompiler_47.dll)
  if(NOT EXISTS "${angle_directory}/${name}")
    message(FATAL_ERROR "Missing ANGLE component: ${angle_directory}/${name}. Run tools/package-angle.ps1 -DestinationDirectory \"${angle_directory}\" before installation, or configure ACP_ANGLE_DIRECTORY.")
  endif()
  if(@ACP_VERIFY_ANGLE_INSTALL@)
    file(SHA256 "${angle_directory}/${name}" actual_hash)
    string(JSON expected_hash GET "${tested_angle}" files "${name}")
    if(NOT actual_hash STREQUAL expected_hash)
      message(FATAL_ERROR "ANGLE hash mismatch for ${name}. Package the tested build, or explicitly configure ACP_VERIFY_ANGLE_INSTALL=OFF for another build.")
    endif()
  endif()
endforeach()
